# Go
backend/tmp/
cli/tmp/
cli/bin/
*.exe
*.test
*.out
vendor/

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# UI embed copy — generated by `make frontend-build && cp -r
# frontend/dist/* backend/internal/uifs/dist/` (or by goreleaser at
# release time). The .gitkeep keeps the dir tracked so go:embed has
# a valid prefix even before the first build.
backend/internal/uifs/dist/*
!backend/internal/uifs/dist/.gitkeep

# eBPF — bpf2go-generated files under ebpf/userspace/ are committed
# so downstream packages compile without clang. Stray .o files outside
# that directory (e.g. dev experiments) stay ignored.
ebpf/**/*.o
!ebpf/userspace/*.o

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker/.env

# Coverage
coverage/
*.coverprofile

# Local design / planning scratch — kept on disk to inform work but
# never pushed to GitHub. TODO.md and BUG-TODO.md are deliberately
# local-only: per-round punch lists belong on the maintainer's
# machine, CHANGELOG.md is the public release narrative.
/project-plan.md
/example.html
/hexagon_logo.png
/TODO.md
/BUG-TODO.md
/BUG.md
